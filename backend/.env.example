# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres_secure_pass
DB_NAME=docmind

# Redis (Caching & Session Store)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Chroma Vector DB
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000

# Authentication
JWT_SECRET=generate_a_very_secure_random_hex_string_here
JWT_REFRESH_SECRET=generate_another_very_secure_random_hex_string_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# NVIDIA NIM AI Service
NVIDIA_API_KEY=nvapi-...
LLM_MODEL=meta/llama-3.1-8b-instruct
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
RERANK_MODEL=nvidia/reranking-nv-embed-rerank-large

# Storage Settings
# Set USE_S3 to True if migrating to AWS S3. Otherwise uses LOCAL storage.
USE_S3=False
UPLOAD_DIR=./data/uploads
AWS_BUCKET_NAME=docmind-enterprise-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
